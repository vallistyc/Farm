# Server-side only. Never prefix these with NEXT_PUBLIC_.
# /api/ai-advice tries providers in this order and skips any provider whose key
# is empty. With no provider configured the route returns 503 and the UI shows a
# setup message instead of calling anything.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Defaults to the free priority list in
# lib/ai-providers.ts when empty.
OPENROUTER_MODELS=
# Free models can be rate limited; this caps how many OpenRouter models to try.
OPENROUTER_MAX_ATTEMPTS=3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase cloud sync for farms and crops. Run supabase/schema.sql first.
# These are safe to expose in the client: the anon/publishable key is public by
# design, and the demo RLS policies in the schema are deliberately permissive.
# Leave empty to run local-only (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the deployed app (e.g. https://your-app.vercel.app). Used as
# the email-confirmation redirect target so "Confirm email" lands on production,
# not localhost. Must also be added to Supabase Auth → URL Configuration
# (Site URL + Redirect URLs allowlist). Falls back to the current origin when
# empty (fine for local dev).
NEXT_PUBLIC_SITE_URL=

# Protects /api/cron/market-prices. Vercel Cron sends it as a bearer token.
# Required in production; local dev may leave it empty.
CRON_SECRET=
